// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {

    id String @id @default(uuid()) //auto-generated unique identifier
    email String @unique //one email per user
    phone String? @unique //optional phone number
    firstName String 
    lastName String
    password String //hashed password
    role String @default("CUSTOMER") //user role, default is "CUSTOMER" 
    status String @default("ACTIVE") //ACTIVE / Banned / Inactive
    createdAt DateTime @default(now()) //timestamp of user creation
    lastLogin DateTime? //timestamp of last login, optional
    privileges String[] @default([]) //array of privileges, default is empty ["users:add","users:edit","users:read"]
    //gender, emailVerified, phoneVerified
}